---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import ContactForm from '../../components/ContactForm.astro';
import SectionHead from '../../components/SectionHead.astro';
import { site } from '../../utils/site';
import { asset } from '../../utils/asset';
import { products, categoryBySlug, formatVnd, productImage, badgeClass, relatedProducts } from '../../utils/catalog';
import occasions from '../../data/occasions.json';

export function getStaticPaths() {
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;
const category = categoryBySlug(product.category);
const related = relatedProducts(product, 3);

// Story facts (Tặng ai · Dịp nào · Bên trong giỏ): every product already
// carries subtitle, tags, and contents — zero schema edits. Occasion names
// deep-link to the catalog's ?tag= filter; the Dịp tặng chip row lights up
// on landing (ProductGrid's tag active-sync).
const occasionLinks = occasions.filter((o) => product.tags.includes(o.tag));

// Self-referencing canonical — same construction as BaseLayout (seo-proposal
// P0-1); also feeds og:url and the JSON-LD Offer/BreadcrumbList URLs below.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const homeUrl = new URL(asset('/'), Astro.site).href;
const productsUrl = new URL(asset('/products/'), Astro.site).href;

// Meta description (seo-proposal P0-5): name + subtitle (every product
// carries one; fall back to the description's first sentence) + the
// price/delivery hook, clamped to ≤160 chars so it never truncates.
const lead = product.subtitle || product.description.split('.')[0].trim();
let metaDescription = `${product.name} — ${lead} · Giá tham khảo ${formatVnd(product.price.amount)}, giao nhanh TP. HCM.`;
if (metaDescription.length > 160) metaDescription = metaDescription.slice(0, 159).trimEnd() + '…';

// Product + Offer + BreadcrumbList structured data (seo-proposal P0-2) —
// built entirely from what this template already renders. The category
// breadcrumb step points at the clean /products/ URL, not the ?category=
// filter variant the visible breadcrumb links to (canonicals consolidate
// those variants away). price is the raw numeric VND amount per schema.org.
const productSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Product',
      name: product.name,
      description: product.description,
      image: new URL(productImage(product), Astro.site).href,
      offers: {
        '@type': 'Offer',
        price: product.price.amount,
        priceCurrency: 'VND',
        availability: `https://schema.org/${product.inStock ? 'InStock' : 'OutOfStock'}`,
        url: canonical,
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Trang chủ', item: homeUrl },
        { '@type': 'ListItem', position: 2, name: 'Giỏ quà', item: productsUrl },
        ...(category
          ? [{ '@type': 'ListItem', position: 3, name: category.name, item: productsUrl }]
          : []),
        {
          '@type': 'ListItem',
          position: category ? 4 : 3,
          name: product.name,
          item: canonical,
        },
      ],
    },
  ],
};
---

<BaseLayout title={product.name} description={metaDescription} ogType="product">
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
  <div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href={asset('/')}>Trang chủ</a> ›
      <a href={asset('/products/')}>Giỏ quà</a> ›
      {category && <a href={`${asset('/products/')}?category=${category.slug}`}>{category.name}</a>} ›
      <span aria-current="page">{product.name}</span>
    </nav>

    <div class="detail-grid">
      <div class="detail-media">
        {product.badge && <span class:list={['badge', badgeClass(product.badge)]}>{product.badge}</span>}
        <img
          src={productImage(product)}
          alt={`Ảnh minh họa: ${product.name}`}
          width="800"
          height="600"
        />
      </div>

      <div>
        {category && (
          <span class="card-cat">
            <a href={`${asset('/products/')}?category=${category.slug}`} style="text-decoration: none;">{category.name}</a>
          </span>
        )}
        <h1 style="margin-bottom: 0.2em;">{product.name}</h1>

        <div class="detail-price">
          <span class="price">{formatVnd(product.price.amount)}</span>
          <small>giá tham khảo cỡ vừa</small>
        </div>

        <p>{product.description}</p>

        {
          (product.subtitle || occasionLinks.length > 0 || (product.contents && product.contents.length > 0)) && (
            <dl class="story-facts">
              {product.subtitle && (
                <div class="story-row">
                  <dt>Tặng ai</dt>
                  <dd>{product.subtitle}</dd>
                </div>
              )}
              {occasionLinks.length > 0 && (
                <div class="story-row">
                  <dt>Dịp nào</dt>
                  <dd>
                    {occasionLinks.map((o, i) => (
                      <Fragment>
                        {i > 0 && ' · '}
                        <a href={`${asset('/products/')}?tag=${o.tag}`}>{o.name}</a>
                      </Fragment>
                    ))}
                  </dd>
                </div>
              )}
              {product.contents && product.contents.length > 0 && (
                <div class="story-row">
                  <dt>Bên trong giỏ</dt>
                  <dd>{`Gồm ${product.contents.length} món: ${product.contents.join(' · ')}`}</dd>
                </div>
              )}
            </dl>
          )
        }

        {
          product.options.length > 0 && (
            <>
              <h3 style="font-family: var(--font-body); font-size: 0.95rem; margin-bottom: 0.2rem;">
                {product.options[0].name}
              </h3>
              <div class="opt-chips">
                {product.options[0].values.map((v) => (
                  <span class="chip">{v}</span>
                ))}
              </div>
              <p style="color: var(--muted); font-size: 0.9rem;">
                Giá thay đổi theo cỡ — nhắn mình cỡ bạn cần, báo giá chốt liền.
              </p>
            </>
          )
        }

        <ul class="meta-list">
          {
            product.personalization.enabled && (
              <li>
                ✍️ <strong>{product.personalization.label}</strong> — miễn phí, tối đa{' '}
                {product.personalization.maxChars} ký tự, viết tay từng thiệp.
              </li>
            )
          }
          <li>🌿 Trái cây &amp; nguyên liệu tuyển mỗi sáng, gói mới ngay trước khi giao.</li>
          <li>🚚 Giao {site.deliveryArea} — cần gấp thì giao nhanh 2h nội thành.</li>
          <li>↩️ Quà hư hỏng khi giao: mình đổi mới ngay trong ngày.</li>
        </ul>

        <div class="hero-cta-row">
          <a class="btn btn--primary btn--big" href={site.zaloUrl} target="_blank" rel="noopener noreferrer">
            Nhắn Zalo đặt giỏ này
          </a>
          <a class="btn btn--ghost btn--big" href={site.phoneHref}>Gọi {site.phoneDisplay}</a>
        </div>
      </div>
    </div>

    <section class="section">
      <SectionHead eyebrow="Gợi ý thêm" title="Vài giỏ nữa bạn có thể thích" />
      <div class="grid-products">
        {
          related.map((p) => (
            <ProductCard product={p} />
          ))
        }
      </div>
    </section>

    <section class="section" style="padding-top: 0;">
      <div class="contact-grid">
        <div>
          <SectionHead
            eyebrow="Đặt giỏ này"
            title="Để mình gọi lại chốt đơn nhé"
            lead="Điền tên, số điện thoại và giỏ đang xem — mình gọi lại trong 30 phút trong giờ mở cửa, tư vấn cỡ và báo giá chốt."
          />
        </div>
        <ContactForm defaultProductSlug={product.slug} />
      </div>
    </section>
  </div>
</BaseLayout>

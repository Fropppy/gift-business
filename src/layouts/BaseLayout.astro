---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../utils/site';
import { asset } from '../utils/asset';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'Giỏ quà cho mọi dịp', description = site.description } = Astro.props;
const pageTitle = `${title} · ${site.name}`;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="vi" data-base={base}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href={asset('/favicon.svg')} />

    <!-- Fonts: Playfair Display (headings) + Be Vietnam Pro (body/UI).
         Both verified (Google fonts metadata) to ship a `vietnamese`
         unicode-range subset (U+0102-0103, U+0110-0111, U+1EA0-1EF9, U+20AB),
         so every diacritic renders in the intended face, not a system fallback. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500;1,600&display=swap"
    />

    <script is:inline>
      // Theme engine — renders exactly as written (is:inline: no TypeScript,
      // no bundling, no dedup) and executes synchronously before first paint,
      // so the right palette resolves with no flash (§2.5).
      // Precedence (§2.7): 1) stored manual choice → 2) seasonal auto →
      // 3) 'base'. One effective id, one attribute.
      (function () {
        var root = document.documentElement;
        var base = (root.dataset.base || '/').replace(/\/$/, '');

        // Whitelist duplicated by necessity: an is:inline script cannot
        // import. Exists in exactly two places: here + the switcher.
        var WHITELIST = ['base', 'tet', 'trung-thu'];

        // 1) stored manual choice — validate before writing to the DOM;
        //    localStorage can throw SecurityError when persistence is blocked.
        var stored = null;
        try { stored = localStorage.getItem('nm:theme'); } catch (e) {}
        var effective = WHITELIST.indexOf(stored) !== -1 ? stored : null;

        // 2) seasonal auto (Nov–Feb → tet; September → trung-thu, a
        //    Gregorian approximation of rằm tháng 8 âm lịch that occasionally
        //    falls in early October — the manual switch is the escape hatch).
        if (!effective) {
          var month = new Date().getMonth() + 1; // 1–12
          if (month === 11 || month === 12 || month === 1 || month === 2) {
            effective = 'tet';
          } else if (month === 9) {
            effective = 'trung-thu';
          }
        }

        // 3) default — the complete base palette carries every token, so
        //    no-JS never renders a hole.
        if (!effective) effective = 'base';

        root.setAttribute('data-theme', effective);

        // Runtime art tokens (L4): a CSS url() cannot carry
        // import.meta.env.BASE_URL and public/ assets need the
        // /gift-business prefix. Year-round files first…
        root.style.setProperty('--hero-1', 'url("' + base + '/images/hero-1.svg")');
        root.style.setProperty('--hero-2', 'url("' + base + '/images/hero-2.svg")');
        root.style.setProperty('--hero-tile', 'url("' + base + '/images/hero-tile.svg")');

        // …then the full Tết dressing — one code path regardless of whether
        // 'tet' came from the calendar or a manual pick in July.
        if (effective === 'tet') {
          root.style.setProperty('--motif-image', 'url("' + base + '/images/hoa-mai.svg")');
          root.style.setProperty('--motif-opacity', '0.08');

          // Point the hero tokens at hero-tet-*.svg — but only once those
          // files actually exist, so dropping Tết photos into public/images/
          // later activates the swap without touching any component.
          ['1', '2', 'tile'].forEach(function (key) {
            var url = base + '/images/hero-tet-' + key + '.svg';
            var probe = new Image();
            probe.onload = function () {
              root.style.setProperty('--hero-' + key, 'url("' + url + '")');
            };
            probe.src = url;
          });
        }

        // Reveal the theme switcher only when JS can run (§2.4) — inert
        // buttons would be worse than absent ones.
        root.setAttribute('data-theme-ui', 'on');
      })();
    </script>
  </head>
  <body>
    <div class="motif-layer" aria-hidden="true"></div>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <a
      class="float-zalo"
      href={site.zaloUrl}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Nhắn Zalo để được tư vấn và đặt quà"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path
          d="M4 5h16a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H9l-5 4v-4H4a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2Z"
          fill="currentColor"
          opacity="0.35"
        ></path>
        <text x="12" y="13.6" text-anchor="middle" font-size="9" font-weight="700" fill="currentColor">Z</text>
      </svg>
      <span>Zalo</span>
    </a>
  </body>
</html>

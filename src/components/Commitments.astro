---
import SectionHead from './SectionHead.astro';

const commitments = [
  {
    title: 'Tươi mỗi sáng',
    body: 'Trái cây và quà mình tuyển mỗi sáng, giỏ nào cũng mới — không để hàng cũ vào giỏ biếu nhà bạn.',
    icon: 'sun',
  },
  {
    title: 'Gói đẹp miễn phí',
    body: 'Gói ghém chu đáo kèm thiệp viết tay theo đúng lời chúc bạn gửi, không thu thêm phí gói.',
    icon: 'ribbon',
  },
  {
    title: 'Giao đúng giờ hẹn',
    body: 'Bạn hẹn khung giờ, mình giao đúng — cần gấp thì giao nhanh 2h trong nội thành.',
    icon: 'clock',
  },
  {
    title: 'Hỏng là đổi ngay',
    body: 'Quà đến nơi mà hư hỏng, mình đổi sản phẩm mới ngay trong ngày — không để bạn khó xử.',
    icon: 'refresh',
  },
];
---

<section class="section section--surface" id="cam-ket">
  <div class="container">
    <SectionHead
      eyebrow="Cam kết"
      title="Cam kết của shop mình"
      lead="Đặt quà online dễ lo lắng mình hiểu — nên mình hứa rõ bốn điều này cho từng đơn."
    />
    <div class="commit-grid">
      {
        commitments.map((c) => (
          <div class="commit">
            <svg class="commit-ico" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              {c.icon === 'sun' && (
                <>
                  <circle cx="12" cy="12" r="4" />
                  <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
                </>
              )}
              {c.icon === 'ribbon' && (
                <>
                  <path d="M12 21c-4 0-7-2-7-5 0-1.7 1.2-2.7 2.6-3.1C6 12.3 5 11 5 9.5 5 7 7.7 5 12 5s7 2 7 4.5c0 1.5-1 2.8-2.6 3.4C17.8 13.3 19 14.3 19 16c0 3-3 5-7 5Z" />
                  <path d="M12 5V3" />
                </>
              )}
              {c.icon === 'clock' && (
                <>
                  <circle cx="12" cy="12" r="9" />
                  <path d="M12 7v5l3 2" />
                </>
              )}
              {c.icon === 'refresh' && (
                <>
                  <path d="M21 12a9 9 0 1 1-2.6-6.4" />
                  <path d="M21 3v6h-6" />
                </>
              )}
            </svg>
            <h3>{c.title}</h3>
            <p>{c.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

---
import { site } from '../utils/site';
import { asset } from '../utils/asset';
---

{/* One static type-led composition (§4.2/§5.3): display headline, one
    concrete promise, CTA row, reassurance tile. No carousel, no dots, no
    rotation timer — the site's only setInterval is gone, which also closes
    the reduced-motion gap (a duration kill cannot stop a timer). */}
<section class="hero-grid container" aria-label="Giới thiệu shop">
  <div class="hero-main">
    <span class="eyebrow">{site.name} · {site.wordmarkSub}</span>
    <h1 class="hero-title">Giỏ quà tươi đẹp, gói chu đáo cho mọi dịp</h1>
    <p class="hero-promise">
      Bạn nhắn mình dịp tặng với ngân sách, mình chọn giúp giỏ đẹp nhất trong tầm giá —
      trái cây mình tuyển mỗi sáng, gói mới khi có đơn mới giao.
    </p>
    <div class="hero-cta-row">
      <a class="btn btn--accent btn--big" href={site.zaloUrl} target="_blank" rel="noopener noreferrer">Nhắn Zalo đặt quà</a>
      <a class="btn btn--ghost btn--big" href={asset('/products/')}>Xem giỏ quà</a>
    </div>
  </div>

  <aside class="hero-tile">
    <div class="hero-tile-body">
      <span class="badge badge--bulk">Giao nhanh 2h</span>
      <h3>Gói đẹp miễn phí, thiệp viết tay</h3>
      <p>
        Mỗi giỏ đều được gói lại ngay trước khi giao, kèm thiệp viết tay theo lời chúc
        bạn gửi — bạn nhắn Zalo mình là có ngay nhé.
      </p>
      <a class="link-more" href={site.zaloUrl} target="_blank" rel="noopener noreferrer">Nhắn mình ngay →</a>
    </div>
    <div class="hero-tile-media">
      <div
        class="hero-tile-art"
        role="img"
        aria-label="Thiệp viết tay kèm dấu sáp đỏ và cành mai nhỏ"
        style="background-image: var(--hero-tile)"
      ></div>
    </div>
  </aside>
</section>

{/* Was carousel slide 2 — the doanh nghiệp message survives as a compact
    one-line band under the hero grid, not a rotating slide. */}
<section class="hero-band container" aria-label="Quà doanh nghiệp">
  <div class="hero-band-copy">
    <strong>Quà doanh nghiệp</strong>
    <p>
      Đặt từ 10 giỏ: gắn logo và thiệp chúc theo yêu cầu, đóng giỏ đồng bộ —
      báo giá nhanh trong {site.replyWithin}.
    </p>
  </div>
  <div class="hero-cta-row">
    <a class="btn btn--accent" href={asset('/products/?category=qua-tang-doanh-nghiep')}>Xem quà doanh nghiệp</a>
    <a class="btn btn--ghost" href={site.phoneHref}>Gọi {site.phoneDisplay}</a>
  </div>
</section>

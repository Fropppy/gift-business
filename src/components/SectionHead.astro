---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  center?: boolean;
}
const { eyebrow, title, lead, center = false } = Astro.props;
---

<div class:list={['section-head', { 'section-head--center': center }]}>
  {eyebrow && <span class="eyebrow">{eyebrow}</span>}
  <h2>{title}</h2>
  {lead && <p class="lead">{lead}</p>}
</div>

---
import { site } from '../utils/site';
import { asset } from '../utils/asset';
import ThemeSwitcher from './ThemeSwitcher.astro';
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={asset('/')}>
      <svg class="brand-ico" viewBox="0 0 64 64" aria-hidden="true">
        <rect width="64" height="64" rx="16" fill="var(--primary)"></rect>
        <g transform="translate(32 32)">
          <g fill="var(--gold)">
            <ellipse rx="6" ry="13" transform="rotate(0) translate(0 -13)"></ellipse>
            <ellipse rx="6" ry="13" transform="rotate(72) translate(0 -13)"></ellipse>
            <ellipse rx="6" ry="13" transform="rotate(144) translate(0 -13)"></ellipse>
            <ellipse rx="6" ry="13" transform="rotate(216) translate(0 -13)"></ellipse>
            <ellipse rx="6" ry="13" transform="rotate(288) translate(0 -13)"></ellipse>
          </g>
          <circle r="6.5" fill="var(--tet)"></circle>
        </g>
      </svg>
      <span class="brand-text">
        <strong>{site.name}</strong>
        <small>{site.wordmarkSub}</small>
      </span>
    </a>

    <nav class="site-nav" id="site-nav" aria-label="Điều hướng chính">
      {
        site.nav.map((item) => (
          <a href={asset(item.href)}>{item.label}</a>
        ))
      }
      <a class="btn btn--primary" href={site.zaloUrl} target="_blank" rel="noopener noreferrer">Nhắn Zalo</a>
      {/* Mobile: the switcher lives INSIDE the nav panel so it never crowds
          the 900px-and-below bar (§2.4). Desktop bar instance sits between
          .site-nav and .header-hotline below. */}
      <ThemeSwitcher class="theme-switch--nav" />
    </nav>

    <ThemeSwitcher class="theme-switch--bar" />

    <a class="header-hotline" href={site.phoneHref}>
      {/* Compact mobile glyph (§8.2) — hidden on desktop via CSS; the
          "Hotline · hours" subline stays desktop-only. */}
      <svg class="header-hotline__ico" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path
          d="M5.5 4h3.6l1.7 4.3-2.3 1.5a11.5 11.5 0 0 0 5.7 5.7l1.5-2.3 4.3 1.7v3.6a2 2 0 0 1-2 2A15.9 15.9 0 0 1 3.5 6a2 2 0 0 1 2-2Z"
          stroke="currentColor"
          stroke-width="2"
          stroke-linejoin="round"></path>
      </svg>
      <strong>{site.phoneDisplay}</strong>
      <small>Hotline · {site.hoursShort}</small>
    </a>

    <button class="nav-toggle" aria-expanded="false" aria-controls="site-nav">
      <span aria-hidden="true">☰</span>
      <span class="visually-hidden">Mở / đóng menu</span>
    </button>
  </div>
</header>

<script>
  // Mobile nav toggle. Query defensively; there is one header.
  // The panel closes on: toggle tap, nav-link navigation, Escape key, and
  // any document-level tap whose target is outside .site-header (§8.2) —
  // every path syncs aria-expanded="false" on the toggle.
  const header = document.querySelector<HTMLElement>('.site-header');
  const nav = document.getElementById('site-nav');
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');

  const closePanel = () => {
    nav?.classList.remove('is-open');
    toggle?.setAttribute('aria-expanded', 'false');
  };

  if (header && nav && toggle) {
    toggle.addEventListener('click', () => {
      const open = nav.classList.toggle('is-open');
      toggle.setAttribute('aria-expanded', String(open));
    });

    nav.querySelectorAll('a').forEach((a) => a.addEventListener('click', closePanel));

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && nav.classList.contains('is-open')) closePanel();
    });

    document.addEventListener('click', (event) => {
      if (nav.classList.contains('is-open') && !header.contains(event.target as Node)) {
        closePanel();
      }
    });
  }
</script>
